const express = require('express');
const axios = require('axios');
const cors = require('cors');
require('dotenv').config();

const app = express();
app.use(cors());
const PORT = 3000;

// 1. Wikipedia History API (No Key Required)
app.get('/api/history', async (req, res) => {
    const { lat, lon } = req.query;
    try {
        const url = `https://en.wikipedia.org/w/api.php?action=query&list=geosearch&gscoord=${lat}|${lon}&gsradius=5000&gslimit=5&format=json&origin=*`;
        const response = await axios.get(url);
        
        // Fetch summaries for each result
        const pages = response.data.query.geosearch;
        const detailedHistory = await Promise.all(pages.map(async (p) => {
            const detailUrl = `https://en.wikipedia.org/w/api.php?action=query&prop=extracts|pageimages&exintro&explaintext&titles=${p.title}&format=json&pithumbsize=400&origin=*`;
            const detailRes = await axios.get(detailUrl);
            const pageData = Object.values(detailRes.data.query.pages)[0];
            return {
                title: p.title,
                lesson: pageData.extract,
                image: pageData.thumbnail?.source
            };
        }));
        res.json(detailedHistory);
    } catch (err) { res.status(500).send(err.message); }
});

// 2. Yelp Restaurant API
app.get('/api/restaurants', async (req, res) => {
    const { lat, lon } = req.query;
    try {
        const response = await axios.get(`https://api.yelp.com/v3/businesses/search`, {
            headers: { Authorization: `Bearer ${process.env.YELP_API_KEY}` },
            params: { latitude: lat, longitude: lon, categories: 'restaurants', limit: 5 }
        });
        res.json(response.data.businesses);
    } catch (err) { res.status(500).send(err.message); }
});

app.listen(PORT, () => console.log(`Server running on port ${PORT}`));
